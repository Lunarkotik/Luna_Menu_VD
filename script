local SEGMENT_COUNT = 24
local ringSegments  = {}
local ringSegLights = {}

local RING_DIRS = {}
for i=1,SEGMENT_COUNT do
    local a=((i-1)/SEGMENT_COUNT)*(2*math_pi)
    local n=(i    /SEGMENT_COUNT)*(2*math_pi)
    RING_DIRS[i]={math_cos(a),math_sin(a),math_cos(n),math_sin(n)}
end

local ringFolder   = nil
local ringBuilt    = false
local lastKillerIn = false
local lastRadius   = -1
local cachedSegLen = 0

local function buildRing()
    if ringFolder then ringFolder:Destroy() end
    ringFolder=Instance.new("Folder") ringFolder.Name="LunaRing" ringFolder.Parent=Workspace
    t_clear(ringSegments) t_clear(ringSegLights)
    local col=Color3.fromRGB(0,210,255)
    for i=1,SEGMENT_COUNT do
        local seg=Instance.new("Part")
        seg.Size=V3(0.12,0.08,1) seg.Material=Enum.Material.Neon seg.Color=col
        seg.Transparency=0.2 seg.Anchored=true seg.CanCollide=false seg.CastShadow=false
        local light=Instance.new("PointLight")
        light.Brightness=1.5 light.Range=4 light.Color=col light.Parent=seg
        seg.Parent=ringFolder ringSegments[i]=seg ringSegLights[i]=light
    end
    ringBuilt=true
end

local function destroyRing()
    if ringFolder then ringFolder:Destroy() ringFolder=nil end
    t_clear(ringSegments) t_clear(ringSegLights) ringBuilt=false lastRadius=-1
end

local function stepRing()
    local hrp=myRoot if not hrp then return end
    local r=Flags.ParryDistance
    local killerIn=false
    local rsq=r*r
    for _,player in ipairs(Players:GetPlayers()) do
        if player~=LocalPlayer and isPlayerKiller(player) then
            local kc=player.Character local kh=kc and kc:FindFirstChild("HumanoidRootPart")
            if kh then local d=hrp.Position-kh.Position if d:Dot(d)<=rsq then killerIn=true break end end
        end
    end
    if not ringBuilt then buildRing() end
    if r~=lastRadius then cachedSegLen=(2*math_pi*r/SEGMENT_COUNT)*1.05 lastRadius=r end
    local segLen=cachedSegLen local halfSeg=-segLen/2
    local center=hrp.Position+V3(0,-2.8,0)
    local colorChanged=killerIn~=lastKillerIn lastKillerIn=killerIn
    local ringColor=killerIn and Color3.fromRGB(255,60,60) or Color3.fromRGB(0,210,255)
    for i=1,SEGMENT_COUNT do
        local d=RING_DIRS[i]
        local pos=center+V3(d[1]*r,0,d[2]*r)
        local ahead=center+V3(d[3]*r,0,d[4]*r)
        local seg=ringSegments[i]
        seg.Size=V3(0.12,0.08,segLen)
        seg.CFrame=CF(pos,ahead)*CF(0,0,halfSeg)
        if colorChanged then seg.Color=ringColor ringSegLights[i].Color=ringColor end
    end
end

