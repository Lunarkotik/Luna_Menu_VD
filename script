-- AIMBOT MATH
------------------------------------------------
local function CalculateExactAimPoint(targetPos)
    local sp=Camera.CFrame.Position local rel=targetPos-sp
    local dx=V3(rel.X,0,rel.Z).Magnitude local dy=rel.Y
    if dx<1 then return nil end
    local v=120 local g=52
    local a=(g*dx*dx)/(2*v*v) local b=-dx local c2=dy+a
    local disc=b*b-4*a*c2 if disc<0 then return nil end
    local tanT=(-b-math_sqrt(disc))/(2*a)
    local theta=math.atan(tanT)-math_rad(2.0)
    return sp+(V3(rel.X/dx,math_tan(theta),rel.Z/dx).Unit*dx)
end

