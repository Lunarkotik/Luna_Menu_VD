local function applyFullbright(s)
    if s then
        Lighting.Brightness=3 Lighting.ClockTime=14
        Lighting.Ambient=Color3.fromRGB(255,255,255)
        Lighting.OutdoorAmbient=Color3.fromRGB(255,255,255)
    else
        Lighting.Brightness=OrigLighting.Brightness Lighting.ClockTime=OrigLighting.ClockTime
        if not Flags.NoShadows then Lighting.GlobalShadows=OrigLighting.GlobalShadows end
        Lighting.Ambient=OrigLighting.Ambient Lighting.OutdoorAmbient=OrigLighting.OutdoorAmbient
    end
end
local function applyNoFog(s)
    if s then Lighting.FogStart=100 Lighting.FogEnd=100
    else Lighting.FogStart=OrigLighting.FogStart Lighting.FogEnd=OrigLighting.FogEnd end
end
local function applyNoShadows(s) Lighting.GlobalShadows=not s end
local function applyNoEffect(s)
    for _,e in ipairs(Lighting:GetChildren()) do
        if e:IsA("BlurEffect") or e:IsA("DepthOfFieldEffect")
        or e:IsA("SunRaysEffect") or e:IsA("ColorCorrectionEffect") then e.Enabled=not s
        elseif e:IsA("Atmosphere") then e.Density=s and 0 or 0.395 e.Haze=0 end
    end
end
Lighting.ChildAdded:Connect(function(c)
    if not Flags.NoEffect then return end
    if c:IsA("BlurEffect") or c:IsA("DepthOfFieldEffect")
    or c:IsA("SunRaysEffect") or c:IsA("ColorCorrectionEffect") then c.Enabled=false
    elseif c:IsA("Atmosphere") then c.Density=0 c.Haze=0 end
end)
task.spawn(function()
    while true do task.wait(15) if Flags.NoEffect then applyNoEffect(true) end end
end)

