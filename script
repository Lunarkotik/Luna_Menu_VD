local function selectTab(name)
    if ActiveTab == name then return end
    for tabName, tabData in pairs(Pages) do
        if tabName == name then
            tabData.Page.Visible = true
            TweenService:Create(tabData.Button, TweenInfo.new(0.2), {BackgroundColor3 = Luna.Theme.Accent, TextColor3 = Luna.Theme.Text}):Play()
        else
            tabData.Page.Visible = false
            TweenService:Create(tabData.Button, TweenInfo.new(0.2), {BackgroundColor3 = Luna.Theme.Panel, TextColor3 = Luna.Theme.TextDark}):Play()
        end
    end
    ActiveTab = name
end

