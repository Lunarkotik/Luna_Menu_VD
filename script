local cachedCheck = nil
local cachedLine  = nil
local cachedGoal  = nil

local function LineInGoal(line, goal)
    local lr = line.Rotation % 360
    local gr = goal.Rotation % 360
    local gs = (gr + 103) % 360
    local ge = (gr + 160) % 360
    return gs > ge and (lr >= gs or lr <= ge) or (lr >= gs and lr <= ge)
end

local function watchCheck(check)
    cachedCheck = check
    cachedLine  = check:WaitForChild("Line", 5)
    cachedGoal  = check:WaitForChild("Goal", 5)
    check.AncestryChanged:Connect(function()
        if not check.Parent then
            cachedCheck = nil
            cachedLine  = nil
            cachedGoal  = nil
        end
    end)
end

local function watchGui(gui)
    local check = gui:FindFirstChild("Check")
    if check then watchCheck(check) end
    gui.ChildAdded:Connect(function(child)
        if child.Name == "Check" then watchCheck(child) end
    end)
    gui.AncestryChanged:Connect(function()
        if not gui.Parent then
            cachedCheck = nil
            cachedLine  = nil
            cachedGoal  = nil
        end
    end)
end

