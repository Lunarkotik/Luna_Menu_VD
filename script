local function selectTab(name)
    if ActiveTab==name then return end
    for tabName, tabData in pairs(Pages) do
        local sel = tabName==name
        tabData.Page.Visible=sel
        TweenService:Create(tabData.Button,TweenInfo.new(0.2),{
            BackgroundColor3=sel and Luna.Theme.Accent or Luna.Theme.Panel,
            TextColor3=sel and Luna.Theme.Text or Luna.Theme.TextDark,
        }):Play()
    end
    ActiveTab=name
end

