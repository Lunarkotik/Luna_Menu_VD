RunService.Heartbeat:Connect(function()
    if Flags.AutoParry then
        -- Heartbeat polling: catches new animation tracks in same frame they appear
        -- AnimationPlayed is deferred — polling is faster
        for player,animator in pairs(animatorCache) do
            if animator.Parent then
                for _,track in ipairs(animator:GetPlayingAnimationTracks()) do
                    if not activeAttacks[track] and track.Animation then
                        if ATTACK_IDS[track.Animation.AnimationId:lower()] then
                            registerAttack(track,player)
                        end
                    end
                end
            end
        end
        for _,attack in pairs(activeAttacks) do checkAttack(attack) end
    end

    local c=LocalPlayer.Character
    if c then
        local target=Flags.SpeedBoostActive and (1+Flags.SpeedBoostValue/100) or 1
        if c:GetAttribute("speedboost")~=target then c:SetAttribute("speedboost",target) end
    end
end)

------------------------------------------------
-- RENDERSTEP — all visuals, single loop
------------------------------------------------
local frameCount = 0
local rotHue     = 0

RunService.RenderStepped:Connect(function(dt)
    frameCount=(frameCount+1)%12

    -- Moonwalk: direct humanoid:Move — no key events, no VIM overhead
    if Flags.Moonwalk and backRun and humanoid and root and root.Parent then
        humanoid:Move(-root.CFrame.LookVector,false)
    end

    -- Parry Ring + Sparkles (every frame = smooth)
    if Flags.ParryRing then
        stepRing()
        if myRoot then stepSparkles(myRoot,lastKillerIn) end
    end

    -- Terror Radius (every frame = smooth line tracking)
    stepTerror()

    -- Souls (every frame = smooth orbit, cached light ref = no FindFirstChild)
    if Flags.LunaSouls then
        soulsFolder.Parent=Workspace
        soulsAnimTime=soulsAnimTime+dt*SPD
        local t=os_clock()
        for p,list in pairs(soulsData) do
            local c=p.Character
            local rp=c and (c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso") or c:FindFirstChild("HumanoidRootPart"))
            if rp then
                local n=#list
                for i,g in ipairs(list) do
                    local add=(i-1)*(math_pi*2/n)
                    local a=soulsAnimTime+add
                    local bob=math_sin(t*2+i)*0.12
                    local pos=rp.Position+V3(math_cos(a)*R_SOUL,HEIGHT+bob,math_sin(a)*R_SOUL)
                    for j=1,3 do g[j].Position=pos end
                    local b=1+math_sin(t*3+i)*0.05
                    g[1].Size=Vector3.one*(SIZE*b)
                    g[2].Size=Vector3.one*(SIZE*2.1*b)
                    g[3].Size=Vector3.one*(SIZE*3.5*b)
                    -- Direct light reference — zero C++ bridge traversal
                    local l=g.light
                    if l then l.Brightness=2+math_sin(t*4)*0.25 end
                    g[3].Transparency=0.82+math_sin(t*2)*0.03
                end
            end
        end
    else
        soulsFolder.Parent=nil
    end

    -- ESP (every 6 frames)
    if frameCount==0 and (Flags.SurvivorESP or Flags.KillerESP) then
        for plr,data in pairs(playerCache) do
            if plr.Parent and plr.Character and data.hl then
                local killer=isPlayerKiller(plr)
                local show=(killer and Flags.KillerESP) or (not killer and Flags.SurvivorESP)
                data.hl.Enabled=show if data.gui then data.gui.Enabled=show end
                if show then
                    local col=killer and COLORS.Killer or COLORS.Survivor
                    data.hl.FillColor=col data.hl.OutlineColor=col
                    if data.label then data.label.Text=plr.Name data.label.TextColor3=col end
                end
            end
        end
    end

    -- Crosshair
    if Flags.Crosshair and crosshairFrame and crosshairGui and crosshairGui.Enabled then
        if (Flags.CrosshairType or "Cross")=="Hook" then
            crosshairFrame.Rotation=(crosshairFrame.Rotation+90*dt)%360
            rotHue=(rotHue+0.5*dt)%1
            local col=Color3.fromHSV(rotHue,1,1)
            for _,p in ipairs(crosshairParts) do if p:IsA("Frame") then p.BackgroundColor3=col end end
        else
            crosshairFrame.Rotation=0
            for _,p in ipairs(crosshairParts) do
                if p:IsA("Frame") then
                    local st=p:FindFirstChildOfClass("UIStroke")
                    if st then st.Color=COLORS.BrightGreen else p.BackgroundColor3=COLORS.BrightGreen end
                end
            end
        end
    end

    -- Aimbot
    if Flags.Aimbot and isPlayerKiller(LocalPlayer) then
        local vc=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
        local mDown=UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
        local closest,minDist=nil,math.huge
        if Drawing then for _,c in pairs(aimbotDrawings) do c.Visible=false end end
        for plr,circle in pairs(aimbotDrawings) do
            if isPlayerSurvivor(plr) and plr.Character then
                local hrp=plr.Character:FindFirstChild("HumanoidRootPart")
                local hum2=plr.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum2 and hum2.Health>0 then
                    local aim=CalculateExactAimPoint(hrp.Position+V3(0,2,0))
                    if aim then
                        local sp,onScreen=Camera:WorldToViewportPoint(aim)
                        if onScreen then
                            if circle then circle.Position=Vector2.new(sp.X,sp.Y) circle.Visible=true end
                            local d=(Vector2.new(sp.X,sp.Y)-vc).Magnitude
                            if d<minDist then minDist=d closest=aim end
                        end
                    end
                end
            end
        end
        if mDown and closest and minDist<=(Flags.AimFOV or 50) then
            local sp=Camera.CFrame.Position
            Camera.CFrame=Camera.CFrame:Lerp(CF(sp,closest),math_clamp(dt*Flags.AimSmoothness*10,0,1))
        end
    end

    -- Char ref refresh (only when broken)
    if not humanoid or not humanoid.Parent or not root or not root.Parent then
        local c=LocalPlayer.Character
        if c then humanoid=c:FindFirstChildOfClass("Humanoid") root=c:FindFirstChild("HumanoidRootPart") end
    end
end)

