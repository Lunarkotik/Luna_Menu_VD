-- AUTO PARRY (Событийная модель — нулевая задержка)
------------------------------------------------
local MAX_DISTANCE     = 10
local PARRY_COOLDOWN   = 0.8
local lastParryTime    = 0

local KnownAttackAnims = {
    ["rbxassetid://129784271201071"] = true,
    ["rbxassetid://117042998468241"] = true,
    ["rbxassetid://105374834496520"] = true,
    ["rbxassetid://115244153053858"] = true,
    ["rbxassetid://117070354890871"] = true,
    ["rbxassetid://138720291317243"] = true,
    ["rbxassetid://122812055447896"] = true,
    ["rbxassetid://135002183282873"] = true,
    ["rbxassetid://118907603246885"] = true,
    ["rbxassetid://80411309607666"]  = true,
    ["rbxassetid://113255068724446"] = true,
    ["rbxassetid://98163597193511"]  = true,
    ["rbxassetid://110355011987939"] = true,
}

-- Таблица подключённых аниматоров чтобы не дублировать события
local connectedAnimators = {}
local playerConnections  = {}

local function PerformParry()
    local now = tick()
    if now - lastParryTime < PARRY_COOLDOWN then return end
    lastParryTime = now
    -- Без task.wait — мгновенный клик
    VirtualInputManager:SendMouseButtonEvent(0, 0, 1, true,  game, 0)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 1, false, game, 0)
end

local function GetPing()
    local ok, val = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    end)
    return ok and val or 0.05
end

local function ShouldParry(killerHRP)
    if not Flags.AutoParry then return false end

    local myChar = LocalPlayer.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return false end

    local ping               = GetPing()
    local adjustedMaxDist    = MAX_DISTANCE + (ping * 30)
    local distance           = (myHRP.Position - killerHRP.Position).Magnitude
    if distance > adjustedMaxDist then return false end

    local relVelocity   = killerHRP.AssemblyLinearVelocity - myHRP.AssemblyLinearVelocity
    local dirToPlayer   = (myHRP.Position - killerHRP.Position).Unit
    local closureSpeed  = killerHRP.AssemblyLinearVelocity:Dot(dirToPlayer)
    local timeToImpact  = distance / math.max(relVelocity.Magnitude, 1)

    return distance <= 6.5
        or closureSpeed > -2
        or timeToImpact <= (0.15 + ping)
end

local function HookAnimator(player, animator)
    if connectedAnimators[animator] then return end

    local conn = animator.AnimationPlayed:Connect(function(track)
        local animObj = track.Animation
        if not animObj then return end
        if not KnownAttackAnims[animObj.AnimationId] then return end
        if player == LocalPlayer then return end

        local char      = player.Character
        local killerHRP = char and char:FindFirstChild("HumanoidRootPart")
        if not killerHRP then return end

        -- Событие сработало в момент старта анимации — проверяем и бьём сразу
        if ShouldParry(killerHRP) then
            PerformParry()
        else
            -- Анимация началась но дистанция пока велика — ждём сближения
            local startTime = tick()
            local checkConn
            checkConn = RunService.Heartbeat:Connect(function()
                -- Истёк трек или прошло 0.5с — снимаем слушатель
                if not track.IsPlaying or (tick() - startTime) > 0.5 then
                    checkConn:Disconnect()
                    return
                end
                local c = player.Character
                local hRP = c and c:FindFirstChild("HumanoidRootPart")
                if hRP and ShouldParry(hRP) then
                    PerformParry()
                    checkConn:Disconnect()
                end
            end)
        end
    end)

    connectedAnimators[animator] = conn
end

local function HookPlayer(player)
    if player == LocalPlayer then return end

    local conns = {}

    local function hookChar(char)
        if not char then return end

        -- Хуки на уже существующий Animator
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local animator = humanoid:FindFirstChildOfClass("Animator")
            if animator then
                HookAnimator(player, animator)
            end
            -- Animator появляется позже — ловим
            table.insert(conns, humanoid.ChildAdded:Connect(function(child)
                if child:IsA("Animator") then
                    HookAnimator(player, child)
                end
            end))
        end
    end

    hookChar(player.Character)

    table.insert(conns, player.CharacterAdded:Connect(function(char)
        -- Новый персонаж — чистим старые аниматорные коннекты не нужные
        hookChar(char)
    end))

    playerConnections[player] = conns
end

local function UnhookPlayer(player)
    local conns = playerConnections[player]
    if conns then
        for _, c in ipairs(conns) do c:Disconnect() end
        playerConnections[player] = nil
    end
end

-- Инициализация всех текущих игроков
for _, player in ipairs(Players:GetPlayers()) do
    HookPlayer(player)
end

Players.PlayerAdded:Connect(HookPlayer)
Players.PlayerRemoving:Connect(UnhookPlayer)

