local function addPlayer(plr)
    if plr==LocalPlayer then return end
    if Drawing then
        local c=Drawing.new("Circle")
        c.Visible=false c.Thickness=2 c.Radius=5
        c.Color=Color3.fromRGB(0,255,255) c.Filled=true c.Transparency=1
        aimbotDrawings[plr]=c
    end
    local function setup(char)
        local head=char:WaitForChild("Head",5) if not head then return end
        local hl=char:FindFirstChild("ESP_HL") or Instance.new("Highlight")
        hl.Name="ESP_HL" hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillTransparency=1 hl.OutlineTransparency=0 hl.Parent=char
        local ex=head:FindFirstChild("ESP_TAG") if ex then ex:Destroy() end
        local bb=Instance.new("BillboardGui")
        bb.Name="ESP_TAG" bb.Size=UDim2.new(0,150,0,30) bb.AlwaysOnTop=true
        bb.Adornee=head bb.StudsOffset=V3(0,2.3,0) bb.Parent=head
        local txt=Instance.new("TextLabel")
        txt.Size=UDim2.new(1,0,1,0) txt.BackgroundTransparency=1
        txt.Font=Enum.Font.GothamBold txt.TextSize=13
        txt.TextColor3=Color3.fromRGB(255,255,255) txt.Text=plr.Name txt.Parent=bb
        playerCache[plr]={char=char,hl=hl,label=txt,gui=bb}
    end
    if plr.Character then setup(plr.Character) end
    plr.CharacterAdded:Connect(function(char) task.wait(0.5) setup(char) end)
end

local function removePlayer(plr)
    playerCache[plr]=nil
    if aimbotDrawings[plr] then aimbotDrawings[plr]:Remove() aimbotDrawings[plr]=nil end
end

local function addGenerator(obj)
    if obj.Name~="Generator" then return end
    local model=obj:IsA("Model") and obj or obj:FindFirstAncestorOfClass("Model")
    if not model or generatorCache[model] then return end
    local part=model:FindFirstChildWhichIsA("BasePart") if not part then return end
    local hl=Instance.new("Highlight")
    hl.Name="GEN_HL" hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillTransparency=1 hl.OutlineTransparency=0
    hl.FillColor=COLORS.GeneratorIncomplete hl.Enabled=Flags.GeneratorESP hl.Parent=model
    local bb=Instance.new("BillboardGui")
    bb.Name="GEN_TAG" bb.Size=UDim2.new(0,120,0,30) bb.AlwaysOnTop=true
    bb.Adornee=part bb.Enabled=Flags.GeneratorESP bb.Parent=part
    local txt=Instance.new("TextLabel")
    txt.Size=UDim2.new(1,0,1,0) txt.BackgroundTransparency=1
    txt.Font=Enum.Font.GothamBold txt.TextSize=13
    txt.TextColor3=Color3.fromRGB(255,255,255) txt.Text="0%" txt.Parent=bb
    local data={model=model,part=part,label=txt,hl=hl,gui=bb}
    generatorCache[model]=data
    local function updatePct()
        local pct=model:GetAttribute("RepairProgress") or model:GetAttribute("Progress") or 0
        txt.Text=string.format("%.0f%%",pct)
        local col=pct>=100 and COLORS.GeneratorComplete or COLORS.GeneratorIncomplete
        hl.FillColor=col hl.OutlineColor=col
        hl.Enabled=Flags.GeneratorESP bb.Enabled=Flags.GeneratorESP
    end
    model:GetAttributeChangedSignal("RepairProgress"):Connect(updatePct)
    model:GetAttributeChangedSignal("Progress"):Connect(updatePct)
    updatePct()
end

local function scanGenerators()
    local map=Workspace:FindFirstChild("Map") if not map then return end
    for _,obj in ipairs(map:GetDescendants()) do addGenerator(obj) end
end
Workspace.DescendantAdded:Connect(function(obj) task.wait(0.2) addGenerator(obj) end)
Workspace.DescendantRemoving:Connect(function(obj)
    local m=obj:IsA("Model") and obj or obj:FindFirstAncestorOfClass("Model")
    if m and generatorCache[m] then generatorCache[m]=nil end
end)

