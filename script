-- Защита от спама (дебаунс)
local canTrigger = true
local cooldown = 0.5 -- время между срабатываниями в секундах

local function performAction()
    if not canTrigger then return end
    canTrigger = false
    
    -- Использование нативной функции эксплойта Xeno для клика ПКМ
    if mouse2press and mouse2release then
        mouse2press()
        task.wait(0.05) -- минимальная задержка зажатия
        mouse2release()
        print("[Luna Script] ПКМ успешно нажат!")
    else
        warn("[Luna Script] Ошибка: функции mouse2press не поддерживаются вашим экплойтом!")
    end
    
    task.delay(cooldown, function()
        canTrigger = true
    end)
end

-- Функция проверки персонажей в радиусе
local function checkNearbyTargets()
    local character = localPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local myRootPos = character.HumanoidRootPart.Position

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local enemyChar = player.Character
            local enemyRoot = enemyChar:FindFirstChild("HumanoidRootPart")
            local humanoid = enemyChar:FindFirstChildOfClass("Humanoid")
            
            if enemyRoot and humanoid then
                local distance = (myRootPos - enemyRoot.Position).Magnitude
                
                if distance <= RADIUS then
                    -- Проверяем играющие анимации по нашему списку
                    for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
                        local animId = track.Animation.AnimationId
                        -- Если ID анимации есть в таблице и она проигрывается
                        if track.IsPlaying and targetAnimId[animId] then 
                            performAction()
                            break
                        end
                    end
                end
            end
        end
    end
end

-- Используем Heartbeat для ежекадрового мониторинга
RunService.Heartbeat:Connect(function()
    pcall(checkNearbyTargets)
end)

