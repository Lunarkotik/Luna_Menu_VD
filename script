-- CONFIG SYSTEM (SAVE / LOAD)
------------------------------------------------
local ConfigFileName = "LunaMenu_Config.json"
local canSaveFiles = (writefile and readfile and isfile) ~= nil

local function SaveConfig()
    if not canSaveFiles then return end
    pcall(function()
        local saveData = {
            Flags = Flags,
            Config = {
                MenuKey = Config.MenuKey.Name,
                MouseUnlockKey = Config.MouseUnlockKey.Name,
                MoonwalkKey = Config.MoonwalkKey.Name
            }
        }
        writefile(ConfigFileName, HttpService:JSONEncode(saveData))
    end)
end

local function LoadConfig()
    if not canSaveFiles then return end
    pcall(function()
        if isfile(ConfigFileName) then
            local decoded = HttpService:JSONDecode(readfile(ConfigFileName))
            if typeof(decoded) == "table" then
                local targetFlags = decoded.Flags or decoded 
                for k, v in pairs(targetFlags) do
                    if Flags[k] ~= nil then Flags[k] = v end
                end
                if decoded.Config then
                    if decoded.Config.MenuKey and Enum.KeyCode[decoded.Config.MenuKey] then
                        Config.MenuKey = Enum.KeyCode[decoded.Config.MenuKey]
                    end
                    if decoded.Config.MouseUnlockKey and Enum.KeyCode[decoded.Config.MouseUnlockKey] then
                        Config.MouseUnlockKey = Enum.KeyCode[decoded.Config.MouseUnlockKey]
                    end
                    if decoded.Config.MoonwalkKey and Enum.KeyCode[decoded.Config.MoonwalkKey] then
                        Config.MoonwalkKey = Enum.KeyCode[decoded.Config.MoonwalkKey]
                    end
                end
            end
        end
    end)
end

LoadConfig()

