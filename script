    if not myHRP then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local killerHRP = char and char:FindFirstChild("HumanoidRootPart")
            local killerHumanoid = char and char:FindFirstChildOfClass("Humanoid")
            
            if killerHRP and killerHumanoid then
                local animator = killerHumanoid:FindFirstChildOfClass("Animator")
                if animator then
                    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                        local animObj = track.Animation
                        if animObj and KnownAttackAnims[animObj.AnimationId] then
                            local isKnightAbility = (animObj.AnimationId == KNIGHT_ABILITY_ANIM)
                            local maxDistance = isKnightAbility and KNIGHT_MAX_DISTANCE or DEFAULT_MAX_DISTANCE
                            local facingThreshold = isKnightAbility and KNIGHT_FACING_THRESHOLD or DEFAULT_FACING_THRESHOLD

                            local predictedKillerPos = killerHRP.Position + (killerHRP.AssemblyLinearVelocity * PING_COMPENSATION)
                            local predictedMyPos = myHRP.Position + (myHRP.AssemblyLinearVelocity * PING_COMPENSATION)

                            if (predictedMyPos - predictedKillerPos).Magnitude <= maxDistance then
                                local killerLookVector = killerHRP.CFrame.LookVector
                                local directionToPlayer = (predictedMyPos - predictedKillerPos).Unit
                                
                                if killerLookVector:Dot(directionToPlayer) >= facingThreshold then
                                    if isKnightAbility then
                                        PerformKnightAbility()
                                    else
                                        PerformParry()
                                    end
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

local function LineInGoal(line, goal)
    local lr = line.Rotation % 360
    local gr = goal.Rotation % 360
    local gs = (gr + 103) % 360
    local ge = (gr + 160) % 360
    return gs > ge and (lr >= gs or lr <= ge) or (lr >= gs and lr <= ge)
end

