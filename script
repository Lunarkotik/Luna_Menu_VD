-- Кэш: player -> последний цвет (не трогаем highlight если цвет не изменился)
local colorCache = {}
-- Кэш соединений для чистки при выходе игрока
local connections = {}

local function getPlayerRole(player)
    if player.Team then
        return player.Team.Name
    end
    for _, attrName in ipairs({"Role", "Team", "Class", "Status"}) do
        local val = player:GetAttribute(attrName)
        if val and type(val) == "string" then return val end
    end
    for _, child in ipairs(player:GetChildren()) do
        if (child:IsA("StringValue") or child:IsA("ObjectValue"))
            and (child.Name == "Role" or child.Name == "Team") then
            return tostring(child.Value)
        end
    end
    return "Unknown"
end

local ROLE_COLORS = {
    survivor  = Color3.fromRGB(50, 255, 50),
    killer    = Color3.fromRGB(255, 0, 0),
    spectator = Color3.fromRGB(255, 255, 255),
}
local DEFAULT_COLOR = Color3.fromRGB(200, 200, 200)

local function getRoleColor(roleName)
    local lower = string.lower(tostring(roleName))
    for key, color in pairs(ROLE_COLORS) do
        if string.find(lower, key, 1, true) then return color end
    end
    return DEFAULT_COLOR
end

local function applyHighlight(character, color)
    if not character then return end
    local highlight = character:FindFirstChild("ExecutorHighlight")
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name          = "ExecutorHighlight"
        highlight.Adornee       = character
        highlight.FillTransparency    = 1
        highlight.OutlineTransparency = 0
        highlight.Parent        = character
    end
    if highlight.FillColor ~= color then
        highlight.FillColor    = color
        highlight.OutlineColor = color
    end
end

-- Обновляет highlight только если цвет реально изменился
local function refreshPlayer(player)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local color = getRoleColor(getPlayerRole(player))
    if colorCache[player] == color then return end  -- ничего не изменилось — выходим
    colorCache[player] = color
    applyHighlight(char, color)
end

local function setupPlayer(player)
    if player == localPlayer then return end

    local playerConns = {}
    connections[player] = playerConns

    -- Highlight при каждом спавне персонажа
    playerConns[#playerConns+1] = player.CharacterAdded:Connect(function(char)
        -- Ждём HumanoidRootPart (безопасно, без polling)
        if not char:FindFirstChild("HumanoidRootPart") then
            char:WaitForChild("HumanoidRootPart", 10)
        end
        colorCache[player] = nil  -- сброс кэша — новый персонаж
        refreshPlayer(player)
    end)

    -- Реагируем мгновенно на смену роли через атрибут
    playerConns[#playerConns+1] = player.AttributeChanged:Connect(function(attr)
        if attr == "Role" or attr == "Team" or attr == "Class" or attr == "Status" then
            refreshPlayer(player)
        end
    end)

    -- Реагируем на смену команды (Team)
    playerConns[#playerConns+1] = player:GetPropertyChangedSignal("Team"):Connect(function()
        refreshPlayer(player)
    end)

    -- Следим за дочерними StringValue/ObjectValue с именем Role/Team
    playerConns[#playerConns+1] = player.ChildAdded:Connect(function(child)
        if (child:IsA("StringValue") or child:IsA("ObjectValue"))
            and (child.Name == "Role" or child.Name == "Team") then
            refreshPlayer(player)
            -- Следим за изменением значения внутри
            child.Changed:Connect(function()
                refreshPlayer(player)
            end)
        end
    end)

    -- Если персонаж уже есть при подключении скрипта
    if player.Character then
        colorCache[player] = nil
        refreshPlayer(player)
    end
end

local function cleanupPlayer(player)
    colorCache[player] = nil
    if connections[player] then
        for _, conn in ipairs(connections[player]) do
            conn:Disconnect()
        end
        connections[player] = nil
    end
end

-- Инициализация всех уже подключённых игроков
for _, player in ipairs(Players:GetPlayers()) do
    task.spawn(setupPlayer, player)
end

Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(cleanupPlayer)

local Workspace  = game:GetService("Workspace")
local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")

local camera         = Workspace.CurrentCamera
local generatorCache = {}

local GENERATOR_COLOR = Color3.fromRGB(255, 220, 0)
local PROGRESS_ATTRS  = {"Progress", "RepairProgress", "Completion", "Repair", "State"}
local COMPLETED_ATTRS = {"IsCompleted", "Completed", "Fixed"}

local function normalizeProgress(val)
    if type(val) ~= "number" then return nil end
    return val <= 1 and (val * 100) or val
end

local function getRawProgress(genModel)
    for _, attr in ipairs(PROGRESS_ATTRS) do
        local v = normalizeProgress(genModel:GetAttribute(attr))
        if v then return v end
    end
    for _, child in ipairs(genModel:GetChildren()) do
        if child:IsA("NumberValue") or child:IsA("IntValue") then
            local n = string.lower(child.Name)
            if string.find(n, "progress", 1, true)
            or string.find(n, "repair",   1, true)
            or string.find(n, "percent",  1, true) then
                local v = normalizeProgress(child.Value)
                if v then return v end
            end
        end
    end
    return 0
end

local function checkCompleted(genModel)
    for _, attr in ipairs(COMPLETED_ATTRS) do
        if genModel:GetAttribute(attr) == true then return true end
    end
    return false
end

local function removeESP(genModel)
    local c = generatorCache[genModel]
    if not c then return end
    if c.highlight then c.highlight:Destroy() end
    if c.billboard then c.billboard:Destroy() end
    for _, conn in ipairs(c.connections) do conn:Disconnect() end
    generatorCache[genModel] = nil
end

local function setupESP(genModel)
    if generatorCache[genModel] then return end
    if checkCompleted(genModel) then return end

    local rootPart = genModel.PrimaryPart
        or genModel:FindFirstChild("Hitbox")
        or genModel:FindFirstChildWhichIsA("BasePart")
    if not rootPart then return end

    local highlight = Instance.new("Highlight")
    highlight.Name                = "GenHighlight"
    highlight.Adornee             = genModel
    highlight.FillTransparency    = 1
    highlight.OutlineColor        = GENERATOR_COLOR
    highlight.OutlineTransparency = 0
    highlight.Parent              = genModel

    local billboard = Instance.new("BillboardGui")
    billboard.Name        = "GenESP_GUI"
    billboard.Adornee     = rootPart
    billboard.StudsOffset = Vector3.new(0, 1.2, 0)
    billboard.AlwaysOnTop = true
    billboard.Size        = UDim2.new(0, 80, 0, 28)

    local label = Instance.new("TextLabel")
    label.Size                   = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3             = GENERATOR_COLOR
    label.TextStrokeTransparency = 0
    label.TextScaled             = true
    label.Font                   = Enum.Font.SourceSansBold
    label.Parent                 = billboard

    billboard.Parent = genModel

    local initProgress = getRawProgress(genModel)

    -- Текст сразу при 0% — не ждёт лерпа
    label.Text = string.format("%.1f%%", initProgress)

    local connections = {}

    local cache = {
        highlight       = highlight,
        billboard       = billboard,
        label           = label,
        rootPart        = rootPart,
        targetProgress  = initProgress,
        displayProgress = initProgress,
        lastH           = nil,
        connections     = connections,
    }
    generatorCache[genModel] = cache

    connections[#connections+1] = genModel.AttributeChanged:Connect(function(attr)
        local c = generatorCache[genModel]
        if not c then return end
        for _, a in ipairs(COMPLETED_ATTRS) do
            if attr == a and genModel:GetAttribute(a) == true then
                removeESP(genModel) return
            end
        end
        for _, a in ipairs(PROGRESS_ATTRS) do
            if attr == a then
                local v = normalizeProgress(genModel:GetAttribute(a))
                if v then
                    c.targetProgress = v
                    if v >= 100 then removeESP(genModel) end
                end
                return
            end
        end
    end)

    local function watchChild(child)
        if not (child:IsA("NumberValue") or child:IsA("IntValue")) then return end
        local n = string.lower(child.Name)
        if not (string.find(n, "progress", 1, true)
             or string.find(n, "repair",   1, true)
             or string.find(n, "percent",  1, true)) then return end

        connections[#connections+1] = child.Changed:Connect(function(val)
            local c = generatorCache[genModel]
            if not c then return end
            local v = normalizeProgress(val)
            if v then
                c.targetProgress = v
                if v >= 100 then removeESP(genModel) end
            end
        end)
    end

    for _, child in ipairs(genModel:GetChildren()) do watchChild(child) end
    connections[#connections+1] = genModel.ChildAdded:Connect(watchChild)

    connections[#connections+1] = genModel.AncestryChanged:Connect(function()
        if not genModel.Parent then removeESP(genModel) end
    end)
end

local function isGenerator(obj)
    if not obj:IsA("Model") then return false end
    local n = string.lower(obj.Name)
    if not string.find(n, "generator", 1, true) then return false end
    return obj:FindFirstChildWhichIsA("BasePart") ~= nil
end

for _, obj in ipairs(Workspace:GetDescendants()) do
    if isGenerator(obj) then pcall(setupESP, obj) end
end

Workspace.DescendantAdded:Connect(function(obj)
    if isGenerator(obj) then
        task.defer(function() pcall(setupESP, obj) end)
    end
end)

RunService.RenderStepped:Connect(function(dt)
    local camPos = camera.CFrame.Position

    for _, cache in pairs(generatorCache) do
        -- Плавный лерп прогресса
        local diff = cache.targetProgress - cache.displayProgress
        if math.abs(diff) > 0.005 then
            cache.displayProgress = cache.displayProgress + diff * math.min(dt * 5, 1)
            cache.label.Text = string.format("%.1f%%", cache.displayProgress)
        end

        -- Масштаб: близко мельче, далеко крупнее — обратная зависимость
        -- UDim2 выделяется только при реальном изменении размера
        local rp = cache.rootPart
        if rp and rp.Parent then
            local dist = (camPos - rp.Position).Magnitude
            local h = math.clamp(math.floor(350 / math.max(dist, 1)), 14, 38)
            if cache.lastH ~= h then
                cache.lastH = h
                cache.billboard.Size = UDim2.new(0, h * 3, 0, h)
            end
        end
    end
end)

local Lighting   = game:GetService("Lighting")
local RunService = game:GetService("RunService")

-- Все классы визуальных эффектов которые убираем
local EFFECT_CLASSES = {
    ["BlurEffect"]             = true,
    ["ColorCorrectionEffect"]  = true,
    ["BloomEffect"]            = true,
    ["SunRaysEffect"]          = true,
    ["DepthOfFieldEffect"]     = true,
    ["BlackAndWhiteEffect"]    = true,
}

-- Дефолтные настройки Lighting — чистая картинка без перебора
local CLEAN_LIGHTING = {
    Brightness        = 2,
    Ambient           = Color3.fromRGB(70, 70, 70),
    OutdoorAmbient    = Color3.fromRGB(100, 100, 100),
    ColorShift_Bottom = Color3.fromRGB(0, 0, 0),
    ColorShift_Top    = Color3.fromRGB(0, 0, 0),
    ExposureCompensation = 0,
    FogEnd            = 100000,
    FogStart          = 0,
    GlobalShadows     = true,
}

-- Убираем один эффект если он в списке
local function removeEffect(obj)
    if EFFECT_CLASSES[obj.ClassName] then
        obj:Destroy()
    end
end

-- Сброс свойств Lighting к чистым значениям
local function cleanLighting()
    for prop, val in pairs(CLEAN_LIGHTING) do
        pcall(function() Lighting[prop] = val end)
    end
end

-- Убираем все текущие эффекты в Lighting
local function removeAllEffects()
    for _, obj in ipairs(Lighting:GetChildren()) do
        removeEffect(obj)
    end
end

-- Первичная чистка
cleanLighting()
removeAllEffects()

-- Игра добавляет новый эффект — убиваем мгновенно
Lighting.ChildAdded:Connect(function(obj)
    task.defer(function()
        removeEffect(obj)
    end)
end)

-- Некоторые игры при respawn сбрасывают Lighting через свойства а не через потомков
-- PropertyChanged ловит это без polling
local WATCHED_PROPS = {
    "Brightness", "Ambient", "OutdoorAmbient",
    "ColorShift_Bottom", "ColorShift_Top",
    "ExposureCompensation", "FogEnd", "FogStart",
}

for _, prop in ipairs(WATCHED_PROPS) do
    pcall(function()
        Lighting:GetPropertyChangedSignal(prop):Connect(function()
            local target = CLEAN_LIGHTING[prop]
            if target and Lighting[prop] ~= target then
                pcall(function() Lighting[prop] = target end)
            end
        end)
    end)
end

-- Respawn detection: LocalPlayer respawn = игра могла сбросить Lighting
local player = game:GetService("Players").LocalPlayer
player.CharacterAdded:Connect(function()
    task.defer(function()
        cleanLighting()
        removeAllEffects()
    end)
end)

