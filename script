local BOOST_MULTIPLIER  = 1.10   -- script speed floor  (1.15 = +15%)
local PENALTY_THRESHOLD = 0.90   -- if game sets value <= this, respect it
------------------------------------------------

local gameSpeedValue = 1
local speedOurSet    = false
local speedConn      = nil

local function connectTracker(char)
    if speedConn then speedConn:Disconnect() speedConn = nil end
    gameSpeedValue = char:GetAttribute("speedboost") or 1
    speedOurSet    = false

    speedConn = char:GetAttributeChangedSignal("speedboost"):Connect(function()
        if speedOurSet then speedOurSet = false return end
        gameSpeedValue = char:GetAttribute("speedboost") or 1
    end)
end

local function setupCharacter(char)
    char:WaitForChild("HumanoidRootPart", 5)
    connectTracker(char)
end

if LocalPlayer.Character then setupCharacter(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.3)
    setupCharacter(char)
end)

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end

    local target

    if gameSpeedValue <= PENALTY_THRESHOLD then
        target = gameSpeedValue                  -- hook / slowdown: don't fight the game
    elseif gameSpeedValue > BOOST_MULTIPLIER then
        target = gameSpeedValue                  -- server buff is already higher: keep it
    else
        target = BOOST_MULTIPLIER                -- apply script floor
    end

    local current = char:GetAttribute("speedboost") or 1
    if math.abs(current - target) > 0.001 then
        speedOurSet = true
        char:SetAttribute("speedboost", target)
    end
end)

