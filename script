        for model, data in pairs(generatorCache) do
            if model and model.Parent and data.label then
                local percent = model:GetAttribute("RepairProgress") or model:GetAttribute("Progress") or 0
                data.label.Text = string.format("%.0f%%", percent)
                
                local isComplete = percent >= 100
                local genColor = isComplete and COLORS.GeneratorComplete or COLORS.GeneratorIncomplete
                
                data.hl.Enabled = Flags.GeneratorESP
                data.hl.FillColor, data.hl.OutlineColor = genColor, genColor
            end
        end
    end

    if Drawing then
        for _, circle in pairs(aimbotDrawings) do
            circle.Visible = false
        end
    end

    if Flags.Aimbot and isPlayerKiller(LocalPlayer) then
        local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local isMouseDown = UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
        local closestTargetPoint = nil
        local minDistanceToCenter = math.huge

        for plr, circle in pairs(aimbotDrawings) do
            if isPlayerSurvivor(plr) and plr.Character then
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                local humanoidTarget = plr.Character:FindFirstChildOfClass("Humanoid")
                
                if hrp and humanoidTarget and humanoidTarget.Health > 0 then
                    local targetWorldPos = hrp.Position + Vector3_new(0, 2.0, 0)
                    local aimWorldPoint = CalculateExactAimPoint(targetWorldPos)
                    
                    if aimWorldPoint then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(aimWorldPoint)

                        if onScreen then
                            if circle then
                                circle.Position = Vector2.new(screenPos.X, screenPos.Y)
                                circle.Visible = Flags.Aimbot
                            end

                            local distToCenter = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
                            if distToCenter < minDistanceToCenter then
                                minDistanceToCenter = distToCenter
                                closestTargetPoint = aimWorldPoint
                            end
                        end
                    end
                end
            end
        end

        if isMouseDown and closestTargetPoint and minDistanceToCenter <= (Flags.AimFOV or 50) then
            local startPos = Camera.CFrame.Position
            local targetLookCFrame = CFrame_new(startPos, closestTargetPoint)
            Camera.CFrame = Camera.CFrame:Lerp(targetLookCFrame, math_clamp(deltaTime * Flags.AimSmoothness * 10, 0, 1))
