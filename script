local ringSegments = {}
local SEGMENT_COUNT = 24

local function updateSparkles(myHRP, isDanger)
    if not sparklesFolder then
        sparklesFolder = Instance.new("Folder")
        sparklesFolder.Name = "LunaSparkles"
        sparklesFolder.Parent = Workspace
    end

    if math_random() < 0.3 and myHRP then
        local angle = math_random() * math.pi * 2
        local dist = math_random() * Flags.ParryDistance
        local offsetX = math.cos(angle) * dist
        local offsetZ = math.sin(angle) * dist
        
        local spark = Instance.new("Part")
        spark.Size = Vector3_new(0.15, 0.15, 0.15)
        spark.Shape = Enum.PartType.Ball
        spark.Material = Enum.Material.Neon
        spark.Color = isDanger and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(0, 210, 255)
        spark.Transparency = 0.3
        spark.Anchored = true
        spark.CanCollide = false
        spark.CastShadow = false
        spark.Position = myHRP.Position + Vector3_new(offsetX, -2.8, offsetZ)
        spark.Parent = sparklesFolder

        task.spawn(function()
            local startTime = tick()
            local duration = 1.2
            while spark and spark.Parent and (tick() - startTime) < duration do
                local alpha = (tick() - startTime) / duration
                spark.Position = spark.Position + Vector3_new(0, 0.05, 0)
                spark.Transparency = 0.3 + (alpha * 0.7)
                task.wait(0.03)
            end
            if spark then spark:Destroy() end
        end)
    end
end

local function updateParryRing()
    if Flags.ParryRing then
        local char = LocalPlayer.Character
        local myHRP = char and char:FindFirstChild("HumanoidRootPart")

        local killerInside = false
        if myHRP then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and isPlayerKiller(player) then
                    local kChar = player.Character
                    local kHRP = kChar and kChar:FindFirstChild("HumanoidRootPart")
                    if kHRP then
                        if (myHRP.Position - kHRP.Position).Magnitude <= Flags.ParryDistance then
                            killerInside = true
                            break
                        end
                    end
                end
            end
        end

        local ringColor = killerInside and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(0, 210, 255)

        if not ringPartsFolder or not ringPartsFolder.Parent then
            ringPartsFolder = Instance.new("Folder")
            ringPartsFolder.Name = "LunaRingSegments"
            ringPartsFolder.Parent = Workspace
            table_clear(ringSegments)

            for i = 1, SEGMENT_COUNT do
                local seg = Instance.new("Part")
                seg.Name = "Segment_" .. i
                seg.Size = Vector3_new(0.12, 0.08, 1)
                seg.Material = Enum.Material.Neon
                seg.Transparency = 0.2
                seg.Anchored = true
                seg.CanCollide = false
                seg.CastShadow = false
                
                local light = Instance.new("PointLight")
                light.Name = "SegmentLight"
                light.Brightness = 1.5
                light.Range = 4
                light.Color = ringColor
                light.Parent = seg

                seg.Parent = ringPartsFolder
                table_insert(ringSegments, seg)
            end
        end

        if myHRP and ringPartsFolder then
            ringPartsFolder.Parent = Workspace
            local radius = Flags.ParryDistance
            local centerPos = myHRP.Position + Vector3_new(0, -2.8, 0)
            local circumference = 2 * math.pi * radius
            local segmentLength = (circumference / SEGMENT_COUNT) * 1.05

            for i, seg in ipairs(ringSegments) do
                seg.Color = ringColor
                local light = seg:FindFirstChild("SegmentLight")
                if light then light.Color = ringColor end
                
                local angle = ((i - 1) / SEGMENT_COUNT) * (2 * math.pi)
                local nextAngle = (i / SEGMENT_COUNT) * (2 * math.pi)
                
                local x = math.cos(angle) * radius
                local z = math.sin(angle) * radius
                local pos = centerPos + Vector3_new(x, 0, z)
                
                seg.Size = Vector3_new(0.12, 0.08, segmentLength)
                seg.CFrame = CFrame_new(pos, centerPos + Vector3_new(math.cos(nextAngle) * radius, 0, math.sin(nextAngle) * radius)) * CFrame_new(0, 0, -segmentLength/2)
            end

            updateSparkles(myHRP, killerInside)
        end
    else
        if ringPartsFolder then
            ringPartsFolder:Destroy()
            ringPartsFolder = nil
            table_clear(ringSegments)
        end
        if sparklesFolder then
            sparklesFolder:ClearAllChildren()
        end
    end
end

------------------------------------------------
-- VEIL AIMBOT BALLISTIC MATH
------------------------------------------------
local function CalculateExactAimPoint(targetPos)
    local startPos = Camera.CFrame.Position
    local rel = targetPos - startPos
    
    local dx = Vector3_new(rel.X, 0, rel.Z).Magnitude
    local dy = rel.Y
    
    if dx < 1 then return nil end

    local v = 120.0
    local g = 52.0

    local a = (g * dx * dx) / (2 * v * v)
    local b = -dx
    local c = dy + a

    local discriminant = (b * b) - (4 * a * c)
    if discriminant < 0 then return nil end

    local tanTheta = (-b - math_sqrt(discriminant)) / (2 * a)
    local theta = math_atan(tanTheta) - math_rad(2.0)
    local adjustedTanTheta = math.tan(theta)

    local dirX = rel.X / dx
    local dirZ = rel.Z / dx

    local finalDir = Vector3_new(dirX, adjustedTanTheta, dirZ).Unit
    return startPos + (finalDir * dx)
end

