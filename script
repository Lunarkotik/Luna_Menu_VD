local ConfigFileName = "LunaMenu_Config.json"
local canSaveFiles   = (writefile and readfile and isfile) ~= nil

local function SaveConfig()
    if not canSaveFiles then return end
    pcall(function()
        writefile(ConfigFileName, HttpService:JSONEncode({
            Flags  = Flags,
            Config = {
                MenuKey        = Config.MenuKey.Name,
                MouseUnlockKey = Config.MouseUnlockKey.Name,
                MoonwalkKey    = Config.MoonwalkKey.Name,
            },
        }))
    end)
end

local function LoadConfig()
    if not canSaveFiles then return end
    pcall(function()
        if isfile(ConfigFileName) then
            local d = HttpService:JSONDecode(readfile(ConfigFileName))
            if type(d) == "table" then
                local f = d.Flags or d
                for k, v in pairs(f) do
                    if Flags[k] ~= nil then Flags[k] = v end
                end
                if d.Config then
                    for _, field in ipairs({"MenuKey","MouseUnlockKey","MoonwalkKey"}) do
                        if d.Config[field] and Enum.KeyCode[d.Config[field]] then
                            Config[field] = Enum.KeyCode[d.Config[field]]
                        end
                    end
                end
            end
        end
    end)
end

LoadConfig()

