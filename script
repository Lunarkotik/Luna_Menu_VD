local function applyFullbright(state)
    if state then
        Lighting.Brightness = 3
        Lighting.ClockTime = 14
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
    else
        Lighting.Brightness = OriginalLighting.Brightness
        Lighting.ClockTime = OriginalLighting.ClockTime
        if not Flags.NoShadows then Lighting.GlobalShadows = OriginalLighting.GlobalShadows end
        Lighting.Ambient = OriginalLighting.Ambient
        Lighting.OutdoorAmbient = OriginalLighting.OutdoorAmbient
    end
end

local function applyNoFog(state)
    if state then
        Lighting.FogStart = 100
        Lighting.FogEnd = 100
    else
        Lighting.FogStart = OriginalLighting.FogStart
        Lighting.FogEnd = OriginalLighting.FogEnd
    end
end

local function applyNoShadows(state)
    Lighting.GlobalShadows = not state
end

local function applyNoEffect(state)
    for _, effect in ipairs(Lighting:GetChildren()) do
        if effect:IsA("BlurEffect") or effect:IsA("DepthOfFieldEffect") or effect:IsA("SunRaysEffect") or effect:IsA("ColorCorrectionEffect") then
            effect.Enabled = not state
        elseif effect:IsA("Atmosphere") then
            effect.Density = state and 0 or 0.395
            effect.Haze = state and 0 or 0
        end
    end
end

