function Luna:Toggle(tabName, name, flagName, callback, sliderConfig, keybindConfig)
    local parentPage = Pages[tabName] and Pages[tabName].Page
    if not parentPage then return nil end

    local hasSlider = sliderConfig ~= nil
    local collapsedHeight = 48
    local expandedHeight = hasSlider and 88 or 48

    local Container = Instance.new("Frame", parentPage)
    Container.Size = UDim2.new(1, -15, 0, collapsedHeight)
    Container.BackgroundColor3 = Luna.Theme.Panel
    Container.BorderSizePixel = 0
    Container.ClipsDescendants = true
    Instance.new("UICorner", Container).CornerRadius = UDim.new(0, 10)

    local TitleLabel = Instance.new("TextLabel", Container)
    TitleLabel.Size = UDim2.new(1, -130, 0, 48)
    TitleLabel.Position = UDim2.new(0, 15, 0, 0)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = name
    TitleLabel.TextColor3 = Luna.Theme.Text
    TitleLabel.Font = Enum.Font.GothamMedium
    TitleLabel.TextSize = 14
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

    local Switch = Instance.new("Frame", Container)
    Switch.Size = UDim2.new(0, 44, 0, 24)
    Switch.Position = UDim2.new(1, -56, 0, 12)
    Switch.BackgroundColor3 = Luna.Theme.ToggleOff
    Instance.new("UICorner", Switch).CornerRadius = UDim.new(1, 0)

    local Dot = Instance.new("Frame", Switch)
    Dot.Size = UDim2.new(0, 18, 0, 18)
    Dot.Position = UDim2.new(0, 3, 0.5, -9)
    Dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", Dot).CornerRadius = UDim.new(1, 0)

    if keybindConfig then
        local KeyButton = Instance.new("TextButton", Container)
        KeyButton.Size = UDim2.new(0, 36, 0, 24)
        KeyButton.Position = UDim2.new(1, -100, 0, 12)
        KeyButton.BackgroundColor3 = Luna.Theme.Button
        KeyButton.Text = keybindConfig.CurrentKey.Name
        KeyButton.TextColor3 = Luna.Theme.Text
        KeyButton.Font = Enum.Font.GothamBold
        KeyButton.TextSize = 10
        Instance.new("UICorner", KeyButton).CornerRadius = UDim.new(0, 6)

        local listening = false
        KeyButton.MouseButton1Click:Connect(function()
            listening = true
            KeyButton.Text = "..."
        end)

        UIS.InputBegan:Connect(function(i)
            if listening and i.UserInputType == Enum.UserInputType.Keyboard then
                listening = false
                keybindConfig.CurrentKey = i.KeyCode
                KeyButton.Text = keybindConfig.CurrentKey.Name
                SaveConfig()
                if keybindConfig.Callback then keybindConfig.Callback(keybindConfig.CurrentKey) end
            end
        end)
    end

    local state = flagName and Flags[flagName] or false
    local sliderHolder = nil

    if hasSlider then
        sliderHolder = Instance.new("Frame", Container)
        sliderHolder.Size = UDim2.new(1, -24, 0, 32)
        sliderHolder.Position = UDim2.new(0, 12, 0, 48)
        sliderHolder.BackgroundTransparency = 1

        local initialVal = sliderConfig.Start
        if flagName and Flags[flagName .. "Value"] ~= nil then
            initialVal = Flags[flagName .. "Value"]
        elseif flagName == "Aimbot" and Flags["AimFOV"] ~= nil then
            initialVal = Flags["AimFOV"]
        end

        local sText = Instance.new("TextLabel", sliderHolder)
        sText.Size = UDim2.new(1, 0, 0, 14)
        sText.Position = UDim2.new(0, 0, 0, 0)
        sText.BackgroundTransparency = 1
        sText.Text = sliderConfig.Name .. ": " .. initialVal
        sText.TextColor3 = Luna.Theme.TextDark
        sText.Font = Enum.Font.GothamMedium
        sText.TextSize = 12
        sText.TextXAlignment = Enum.TextXAlignment.Left

        local Bar = Instance.new("Frame", sliderHolder)
        Bar.Size = UDim2.new(1, 0, 0, 6)
        Bar.Position = UDim2.new(0, 0, 0, 20)
        Bar.BackgroundColor3 = Luna.Theme.Button
        Instance.new("UICorner", Bar).CornerRadius = UDim.new(1, 0)

        local Fill = Instance.new("Frame", Bar)
        Fill.Size = UDim2.new((initialVal - sliderConfig.Min) / (sliderConfig.Max - sliderConfig.Min), 0, 1, 0)
        Fill.BackgroundColor3 = Luna.Theme.Accent
        Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

        local Knob = Instance.new("Frame", Fill)
        Knob.Size = UDim2.new(0, 10, 0, 10)
        Knob.Position = UDim2.new(1, -5, 0.5, -5)
        Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

        local Drag = false
        local function SetVal(v)
            v = math_round(math_clamp(v, sliderConfig.Min, sliderConfig.Max))
            Fill.Size = UDim2.new((v - sliderConfig.Min) / (sliderConfig.Max - sliderConfig.Min), 0, 1, 0)
            sText.Text = sliderConfig.Name .. ": " .. v
            if flagName == "Aimbot" then
                Flags["AimFOV"] = v
                SaveConfig()
            elseif flagName then
                Flags[flagName .. "Value"] = v
                SaveConfig()
            end
            if sliderConfig.Callback then sliderConfig.Callback(v) end
        end

        Bar.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then Drag = true end
        end)
        UIS.InputChanged:Connect(function(i)
            if Drag and i.UserInputType == Enum.UserInputType.MouseMovement then
                local x = (i.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X
                SetVal(sliderConfig.Min + (sliderConfig.Max - sliderConfig.Min) * x)
            end
        end)
        UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then Drag = false end
        end)
    end

    local function SetState(newState, instant)
        if state == newState and not instant then return end
        state = newState
        if flagName then
            Flags[flagName] = state
            SaveConfig()
        end
        local tInfo = TweenInfo.new(instant and 0 or 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        
        if state then
            TweenService:Create(Switch, tInfo, {BackgroundColor3 = Luna.Theme.ToggleOn}):Play()
            TweenService:Create(Dot, tInfo, {Position = UDim2.new(1, -21, 0.5, -9)}):Play()
            TweenService:Create(Container, tInfo, {Size = UDim2.new(1, -15, 0, expandedHeight)}):Play()
        else
            TweenService:Create(Switch, tInfo, {BackgroundColor3 = Luna.Theme.ToggleOff}):Play()
            TweenService:Create(Dot, tInfo, {Position = UDim2.new(0, 3, 0.5, -9)}):Play()
            TweenService:Create(Container, tInfo, {Size = UDim2.new(1, -15, 0, collapsedHeight)}):Play()
        end
        if callback then callback(state) end
    end

    if state then SetState(true, true) end

    local function Trigger()
        SetState(not state)
    end

    TitleLabel.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then Trigger() end
    end)
    Switch.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then Trigger() end
    end)

    return Container, SetState
end

