-- Caching light avoids FindFirstChildOfClass every RenderStepped frame
local function buildSoul(c)
    local a={createSoulPart(SIZE,0,c),createSoulPart(SIZE*2.1,0.6,c),createSoulPart(SIZE*3.5,0.82,c)}
    local l=Instance.new("PointLight",a[1])
    l.Color=c l.Brightness=2 l.Range=6
    a.light=l   -- direct reference — no FindFirstChildOfClass needed
    local at=Instance.new("Attachment",a[1])
    local sm=Instance.new("ParticleEmitter",at)
    sm.Texture="rbxasset://textures/particles/smoke_main.dds" sm.Color=ColorSequence.new(c)
    sm.Rate=15 sm.Lifetime=NumberRange.new(1,2) sm.Speed=NumberRange.new(0.1,0.3)
    sm.Size=NumberSequence.new(0.4) sm.Transparency=NumberSequence.new(0.5,1)
    return a
end

local function addSoulFx(g)
    local at=g[1]:FindFirstChildOfClass("Attachment") if not at then return end
    local sp=Instance.new("ParticleEmitter",at)
    sp.Texture="rbxasset://textures/particles/sparkles_main.dds" sp.Color=ColorSequence.new(g[1].Color)
    sp.Rate=0.8 sp.Lifetime=NumberRange.new(0.3,0.7) sp.Speed=NumberRange.new(0.2,0.6)
    sp.Size=NumberSequence.new(0.06) sp.LightEmission=1
end

local function clearSoul(p)
    local d=soulsData[p] if not d then return end
    for _,g in ipairs(d) do for _,v in ipairs(g) do pcall(function() v:Destroy() end) end end
    soulsData[p]=nil
end

local function buildPlayerSouls(p)
    clearSoul(p) if not Flags.LunaSouls then return end
    local n=math.clamp(3-(p:GetAttribute("HookCount") or 0),0,3) if n==0 then return end
    soulsData[p]={}
    for i=1,n do t_insert(soulsData[p],buildSoul(soulColors[i])) end
end

local function setupSoulPlayer(p)
    p.CharacterAdded:Connect(function() task.wait(0.5) if Flags.LunaSouls then buildPlayerSouls(p) end end)
    p:GetAttributeChangedSignal("HookCount"):Connect(function() if Flags.LunaSouls then buildPlayerSouls(p) end end)
    if p.Character and Flags.LunaSouls then buildPlayerSouls(p) end
end
for _,p in ipairs(Players:GetPlayers()) do setupSoulPlayer(p) end
Players.PlayerAdded:Connect(setupSoulPlayer)
Players.PlayerRemoving:Connect(clearSoul)
task.spawn(function()
    while true do task.wait(3)
        if Flags.LunaSouls then
            for _,list in pairs(soulsData) do
                for _,g in ipairs(list) do
                    if not g[1]:FindFirstChildOfClass("Attachment"):FindFirstChildOfClass("ParticleEmitter") then
                        addSoulFx(g)
                    end
                end
            end
        end
    end
end)

