local function rebuildCrosshair()
    if crosshairFrame then crosshairFrame:Destroy() crosshairFrame=nil end
    t_clear(crosshairParts)
    if not Flags.Crosshair then return end
    crosshairGui=crosshairGui or Instance.new("ScreenGui",GuiParent)
    crosshairGui.Name="RainbowCrosshairGui" crosshairGui.ResetOnSpawn=false crosshairGui.IgnoreGuiInset=true
    crosshairFrame=Instance.new("Frame")
    crosshairFrame.Name="CrosshairContainer" crosshairFrame.Size=UDim2.new(0,40,0,40)
    crosshairFrame.Position=UDim2.new(0.5,0,0.5,0) crosshairFrame.AnchorPoint=Vector2.new(0.5,0.5)
    crosshairFrame.BackgroundTransparency=1 crosshairFrame.Parent=crosshairGui
    local cType=Flags.CrosshairType or "Cross"
    local function mkF(sz,pos,anc,rnd)
        local f=Instance.new("Frame")
        f.Size=sz f.Position=pos f.AnchorPoint=anc or Vector2.new(0.5,0.5)
        f.BackgroundColor3=COLORS.BrightGreen f.BorderSizePixel=0
        if rnd then Instance.new("UICorner",f).CornerRadius=UDim.new(1,0) end
        f.Parent=crosshairFrame t_insert(crosshairParts,f) return f
    end
    if cType=="Dot" then
        mkF(UDim2.new(0,6,0,6),UDim2.new(0.5,0,0.5,0),nil,true)
    elseif cType=="Cross" then
        mkF(UDim2.new(0,10,0,2),UDim2.new(0.5,0,0.5,0))
        mkF(UDim2.new(0,2,0,10),UDim2.new(0.5,0,0.5,0))
    elseif cType=="Ring" then
        local r=Instance.new("Frame")
        r.Size=UDim2.new(0,10,0,10) r.Position=UDim2.new(0.5,0,0.5,0)
        r.AnchorPoint=Vector2.new(0.5,0.5) r.BackgroundTransparency=1 r.Parent=crosshairFrame
        Instance.new("UICorner",r).CornerRadius=UDim.new(1,0)
        local st=Instance.new("UIStroke",r) st.Thickness=2 st.Color=COLORS.BrightGreen
        t_insert(crosshairParts,r)
    elseif cType=="Hook" then
        crosshairFrame.Size=UDim2.new(0,16,0,16)
        local hl=8
        local function mkL(nm,sz,pos)
            local l=Instance.new("Frame")
            l.Name=nm l.Size=sz l.Position=pos l.AnchorPoint=Vector2.new(0.5,0.5)
            l.BorderSizePixel=0 l.BackgroundColor3=COLORS.BrightGreen l.Parent=crosshairFrame
