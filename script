local soulsFolder = workspace:FindFirstChild("LunaSouls") or Instance.new("Folder", workspace)
soulsFolder.Name = "LunaSouls"

local R = 1.25
local SPD = 1.8
local SIZE = .22
local HEIGHT = 3

local soulColors = {
    Color3.fromRGB(190, 120, 255),
    Color3.fromRGB(130, 190, 255),
    Color3.fromRGB(100, 240, 255)
}

local soulsData = {}

local function createSoulPart(s, t, c)
    local p = Instance.new("Part")
    p.Size = Vector3.one * s
    p.Shape = Enum.PartType.Ball
    p.Material = Enum.Material.Neon
    p.Color = c
    p.Transparency = t
    p.Anchored = true
    p.CanCollide = false
    p.CastShadow = false
    p.Parent = soulsFolder
    return p
end

local function buildSoul(c)
    local a = {
        createSoulPart(SIZE, 0, c),
        createSoulPart(SIZE * 2.1, .6, c),
        createSoulPart(SIZE * 3.5, .82, c)
    }

    local l = Instance.new("PointLight", a[1])
    l.Color = c
    l.Brightness = 2
    l.Range = 6

    local at = Instance.new("Attachment", a[1])

    local sm = Instance.new("ParticleEmitter", at)
    sm.Texture = "rbxasset://textures/particles/smoke_main.dds"
    sm.Color = ColorSequence.new(c)
    sm.Rate = 15
    sm.Lifetime = NumberRange.new(1, 2)
    sm.Speed = NumberRange.new(.1, .3)
    sm.Size = NumberSequence.new(.4)
    sm.Transparency = NumberSequence.new(0.5, 1)

    return a
end

local function getHookCount(p)
    return math.clamp(3 - (p:GetAttribute("HookCount") or 0), 0, 3)
end

local function clearSoul(p)
    local d = soulsData[p]
    if not d then return end
    for _, g in ipairs(d) do
        for _, v in ipairs(g) do
            v:Destroy()
        end
    end
    soulsData[p] = nil
end

local function buildPlayerSouls(p)
    clearSoul(p)
    if not Flags.LunaSouls then return end

    local n = getHookCount(p)
    if n == 0 then return end

    soulsData[p] = {}
    for i = 1, n do
        table_insert(soulsData[p], buildSoul(soulColors[i]))
    end
end

local function setupSoulPlayer(p)
    p.CharacterAdded:Connect(function()
        task.wait(.5)
        if Flags.LunaSouls then
            buildPlayerSouls(p)
        end
    end)

    p:GetAttributeChangedSignal("HookCount"):Connect(function()
        if Flags.LunaSouls then
            buildPlayerSouls(p)
        end
    end)

    if p.Character and Flags.LunaSouls then
        buildPlayerSouls(p)
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    setupSoulPlayer(p)
end

Players.PlayerAdded:Connect(setupSoulPlayer)
Players.PlayerRemoving:Connect(clearSoul)

local soulsAnimTime = 0

RunService.RenderStepped:Connect(function(dt)
    if not Flags.LunaSouls then 
        soulsFolder.Parent = nil
        return 
    end
    soulsFolder.Parent = workspace

    soulsAnimTime += dt * SPD

    for p, list in pairs(soulsData) do
        local c = p.Character
        local rootPart = c and (c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso") or c:FindFirstChild("HumanoidRootPart"))

        if rootPart then
            local n = #list
            for i, g in ipairs(list) do
                local add = (i - 1) * (math.pi * 2 / n)
                local a = soulsAnimTime + add
                local bob = math.sin(os.clock() * 2 + i) * .12

                local pos = rootPart.Position + Vector3.new(
                    math.cos(a) * R,
                    HEIGHT + bob,
                    math.sin(a) * R
                )

                for _, v in ipairs(g) do
                    v.Position = pos
                end

                local b = 1 + math.sin(os.clock() * 3 + i) * .05
                g[1].Size = Vector3.one * (SIZE * b)
                g[2].Size = Vector3.one * (SIZE * 2.1 * b)
                g[3].Size = Vector3.one * (SIZE * 3.5 * b)
            end
        end
    end
end)

local function addSoulFx(g)
    local a = g[1]:FindFirstChildOfClass("Attachment")
    if not a then return end

    local sp = Instance.new("ParticleEmitter", a)
    sp.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    sp.Color = ColorSequence.new(g[1].Color)
    sp.Rate = .8
    sp.Lifetime = NumberRange.new(.3, .7)
    sp.Speed = NumberRange.new(.2, .6)
    sp.Size = NumberSequence.new(.06)
    sp.LightEmission = 1
end

