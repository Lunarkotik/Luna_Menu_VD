------------------------------------------------
-- SETTINGS
------------------------------------------------

local DEFAULT_PARRY_DISTANCE   = 10
local KNIGHT_ABILITY_DISTANCE  = 20

-- Main new setting:
-- inside this distance, FOV/facing is ignored
-- and parry happens immediately when attack animation
-- is detected.
local POINT_BLANK_DISTANCE     = 4

local DEFAULT_FACING_THRESHOLD = 0.60
local KNIGHT_ABILITY_THRESHOLD = 0.30

local KNIGHT_ABILITY_ID =
    "rbxassetid://80411309607666"

------------------------------------------------
-- STATE
------------------------------------------------

local parryConnections = {}
local enemyRootCache   = {}
local activeAttacks    = {}
local triggeredTracks  = {}

------------------------------------------------
-- PARRY REMOTE
------------------------------------------------

local parryEvent = nil

pcall(function()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local items   = remotes and remotes:FindFirstChild("Items")
    local dagger  = items and items:FindFirstChild("Parry Dagger")

    if dagger then
        parryEvent = dagger:FindFirstChild("parry")
    end
end)

------------------------------------------------
-- INSTANT PARRY
------------------------------------------------

local function instantParry(isKnightAbility)

    ------------------------------------------------
    -- Knight ability
    ------------------------------------------------

    if isKnightAbility then

        VIM:SendKeyEvent(
            true,
            Enum.KeyCode.LeftControl,
            false,
            game
        )

        VIM:SendKeyEvent(
            false,
            Enum.KeyCode.LeftControl,
            false,
            game
        )

        return
    end

    ------------------------------------------------
    -- Remote first
    ------------------------------------------------

    if parryEvent then
        pcall(function()
            parryEvent:FireServer()
        end)
    end

    ------------------------------------------------
    -- Mouse fallback
    ------------------------------------------------

    VIM:SendMouseButtonEvent(
        0,
        0,
        1,
        true,
        game,
        0
    )

    VIM:SendMouseButtonEvent(
        0,
        0,
        1,
        false,
        game,
        0
    )
end

------------------------------------------------
-- ANIMATION ID
------------------------------------------------

local function getAnimationId(track)

    if not track then
        return nil
    end

    local animation = track.Animation

    if not animation then
        return nil
    end

    return tostring(
        animation.AnimationId
    ):lower()
end

------------------------------------------------
-- REMOVE ATTACK
------------------------------------------------

local function removeAttack(track)

    if track then
        activeAttacks[track] = nil
    end
end

------------------------------------------------
-- VALIDATE ATTACK
------------------------------------------------

local function validateAttack(attack)

    if attack.triggered then
        return false
    end

    if not Flags.AutoParry then
        return false
    end

    local player = attack.player

    if not player or not player.Parent then
        return false
    end

    ------------------------------------------------
    -- Enemy character
    ------------------------------------------------

    local enemyCharacter =
        player.Character

    if not enemyCharacter then
        return false
    end

    ------------------------------------------------
    -- Enemy root
    ------------------------------------------------

    local enemyRoot =
        attack.enemyRoot

    if not enemyRoot or
       not enemyRoot.Parent then

        enemyRoot =
            enemyCharacter:FindFirstChild(
                "HumanoidRootPart"
            )

        if not enemyRoot then
            return false
        end

        attack.enemyRoot =
            enemyRoot

        enemyRootCache[player] =
            enemyRoot
    end

    ------------------------------------------------
    -- Local character/root
    ------------------------------------------------

    local myCharacter =
        LocalPlayer.Character

    if not myCharacter then
        return false
    end

    local myRoot =
        myCharacter:FindFirstChild(
            "HumanoidRootPart"
        )

    if not myRoot then
        return false
    end

    ------------------------------------------------
    -- Attack type
    ------------------------------------------------

    local isKnightAbility =
        attack.animId ==
        KNIGHT_ABILITY_ID

    local maxDistance =
        isKnightAbility
        and KNIGHT_ABILITY_DISTANCE
        or DEFAULT_PARRY_DISTANCE

    ------------------------------------------------
    -- DISTANCE
    --
    -- Squared distance avoids Magnitude.
    ------------------------------------------------

    local diff =
        myRoot.Position -
        enemyRoot.Position

    local distanceSquared =
        diff:Dot(diff)

    if distanceSquared < 0.000001 then
        return false
    end

    local distance =
        math_sqrt(distanceSquared)

    ------------------------------------------------
    -- POINT-BLANK FAST PATH
    --
    -- This is the most important change.
    --
    -- At very close range we DON'T wait for
    -- facing/FOV. The attack animation itself
    -- is enough to trigger the parry.
    ------------------------------------------------

    if not isKnightAbility and
       distance <= POINT_BLANK_DISTANCE then

        attack.pointBlank = true

        return true, false
    end

    ------------------------------------------------
    -- NORMAL DISTANCE LIMIT
    ------------------------------------------------

    if distance > maxDistance then
        return false
    end

    ------------------------------------------------
    -- NORMAL FACING CHECK
    ------------------------------------------------

    local direction =
        diff * (1 / distance)

    local dot =
        enemyRoot.CFrame.LookVector:Dot(
            direction
        )

    local threshold

    if isKnightAbility then
        threshold =
            KNIGHT_ABILITY_THRESHOLD
    else
        local angle =
            math_clamp(
                Flags.TerrorAngle or 90,
                0,
                360
            )

        threshold =
            math_cos(
                math_rad(angle * 0.5)
            )
    end

    if dot < threshold then
        return false
    end

    return true, isKnightAbility
end

------------------------------------------------
-- FIRE PARRY
------------------------------------------------

local function fireParry(attack, isKnightAbility)

    if attack.triggered then
        return
    end

    attack.triggered = true
    attack.isKnightAbility =
        isKnightAbility

    local track =
        attack.track

    if track then
        triggeredTracks[track] = true
        activeAttacks[track] = nil
    end

    ------------------------------------------------
    -- NO WAIT HERE
    ------------------------------------------------

    instantParry(isKnightAbility)

    ------------------------------------------------
    -- Cleanup only
    ------------------------------------------------

    if track then

        task.spawn(function()

            if track.IsPlaying then
                track.Stopped:Wait()
            end

            triggeredTracks[track] = nil

        end)

    end
end

------------------------------------------------
-- CHECK ATTACK
------------------------------------------------

local function checkAttack(attack)

    if attack.triggered then
        return true
    end

    local track =
        attack.track

    if not track then
        return false
    end

    ------------------------------------------------
    -- Animation ended
    ------------------------------------------------

    if not track.IsPlaying then
        removeAttack(track)
        triggeredTracks[track] = nil
        return false
    end

    if track.Length > 0 and
       track.TimePosition >= track.Length then

        removeAttack(track)
        triggeredTracks[track] = nil
        return false
    end

    ------------------------------------------------
    -- Validate
    ------------------------------------------------

    local ok, isKnight =
        validateAttack(attack)

    if not ok then
        return false
    end

    ------------------------------------------------
    -- FIRE IMMEDIATELY
    ------------------------------------------------

    fireParry(
        attack,
        isKnight
    )

    return true
end

------------------------------------------------
-- REGISTER ATTACK
--
-- AnimationPlayed is the primary path.
------------------------------------------------

local function registerAttack(track, player)

    if not Flags.AutoParry then
        return
    end

    if not track or
       not track.Animation then
        return
    end

    if triggeredTracks[track] then
        return
    end

    if activeAttacks[track] then
        return
    end

    ------------------------------------------------
    -- Killer only
    ------------------------------------------------

    if not player.Team or
       player.Team.Name ~= "Killer" then

        return
    end

    ------------------------------------------------
    -- Animation
    ------------------------------------------------

    local animId =
        getAnimationId(track)

    if not animId or
       not ATTACK_IDS[animId] then

        return
    end

    ------------------------------------------------
    -- Enemy root
    ------------------------------------------------

    local enemyRoot =
        enemyRootCache[player]

    if not enemyRoot or
       not enemyRoot.Parent then

        local character =
            player.Character

        if not character then
            return
        end

        enemyRoot =
            character:FindFirstChild(
                "HumanoidRootPart"
            )

        if not enemyRoot then
            return
        end

        enemyRootCache[player] =
            enemyRoot
    end

    ------------------------------------------------
    -- Attack state
    ------------------------------------------------

    local attack = {
        track = track,
        player = player,
        enemyRoot = enemyRoot,
        animId = animId,
        triggered = false,
        pointBlank = false,
        isKnightAbility =
            animId == KNIGHT_ABILITY_ID,
    }

    activeAttacks[track] =
        attack

    ------------------------------------------------
    -- CRITICAL:
    -- Immediate synchronous check.
    ------------------------------------------------

    if checkAttack(attack) then
        return
    end

    ------------------------------------------------
    -- Keep checking this exact attack.
    ------------------------------------------------

    track.Stopped:Connect(
        function()

            activeAttacks[track] = nil
            triggeredTracks[track] = nil

        end
    )
end

------------------------------------------------
-- CHARACTER WATCH
------------------------------------------------

local function watchCharacter(
    player,
    character
)

    ------------------------------------------------
    -- Disconnect previous
    ------------------------------------------------

    if parryConnections[player] then

        for _, connection in
            ipairs(
                parryConnections[player]
            ) do

            connection:Disconnect()

        end

        parryConnections[player] =
            nil
    end

    ------------------------------------------------
    -- Humanoid
    ------------------------------------------------

    local humanoid =
        character:WaitForChild(
            "Humanoid",
            5
        )

    if not humanoid then
        return
    end

    ------------------------------------------------
    -- Animator
    ------------------------------------------------

    local animator =
        humanoid:WaitForChild(
            "Animator",
            5
        )

    if not animator then
        return
    end

    ------------------------------------------------
    -- Root
    ------------------------------------------------

    local root =
        character:WaitForChild(
            "HumanoidRootPart",
            5
        )

    if not root then
        return
    end

    enemyRootCache[player] =
        root

    ------------------------------------------------
    -- Connections
    ------------------------------------------------

    local connections = {}

    parryConnections[player] =
        connections

    ------------------------------------------------
    -- PRIMARY:
    -- AnimationPlayed
    ------------------------------------------------

    connections[#connections + 1] =
        animator.AnimationPlayed:Connect(
            function(track)

                if Flags.AutoParry then

                    registerAttack(
                        track,
                        player
                    )

                end

            end
        )

    ------------------------------------------------
    -- Catch already playing attacks
    ------------------------------------------------

    if Flags.AutoParry then

        for _, track in
            ipairs(
                animator:GetPlayingAnimationTracks()
            ) do

            registerAttack(
                track,
                player
            )

        end

    end
end

------------------------------------------------
-- PLAYER WATCH
------------------------------------------------

local function watchPlayer(player)

    if player == LocalPlayer then
        return
    end

    if player.Character then

        watchCharacter(
            player,
            player.Character
        )

    end

    player.CharacterAdded:Connect(
        function(character)

            watchCharacter(
                player,
                character
            )

        end
    )
end

------------------------------------------------
-- INITIAL PLAYERS
------------------------------------------------

for _, player in
    ipairs(
        Players:GetPlayers()
    ) do

    watchPlayer(player)

end

------------------------------------------------
-- NEW PLAYERS
------------------------------------------------

Players.PlayerAdded:Connect(
    watchPlayer
)

------------------------------------------------
-- PLAYER REMOVAL
------------------------------------------------

Players.PlayerRemoving:Connect(
    function(player)

        enemyRootCache[player] =
            nil

        if parryConnections[player] then

            for _, connection in
                ipairs(
                    parryConnections[player]
                ) do

                connection:Disconnect()

            end

            parryConnections[player] =
                nil

        end

        for track, attack in
            pairs(activeAttacks) do

            if attack.player == player then
                activeAttacks[track] = nil
            end

        end

    end
)

------------------------------------------------
-- FAST FALLBACK
--
-- Only checks already detected attacks.
-- Does NOT scan all animations.
------------------------------------------------

RunService.RenderStepped:Connect(
    function()

        if not Flags.AutoParry then
            return
        end

        for track, attack in
            pairs(activeAttacks) do

            checkAttack(attack)

        end

    end
)
