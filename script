local function rebuildCrosshair()
    if crosshairFrame then
        crosshairFrame:Destroy()
        crosshairFrame = nil
    end
    table_clear(crosshairParts)

    if not Flags.Crosshair then return end

    crosshairGui = crosshairGui or Instance.new("ScreenGui", GuiParent)
    crosshairGui.Name = "RainbowCrosshairGui"
    crosshairGui.ResetOnSpawn = false
    crosshairGui.IgnoreGuiInset = true

    crosshairFrame = Instance.new("Frame")
    crosshairFrame.Name = "CrosshairContainer"
    crosshairFrame.Size = UDim2.new(0, 40, 0, 40)
    crosshairFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    crosshairFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    crosshairFrame.BackgroundTransparency = 1
    crosshairFrame.Parent = crosshairGui

    local cType = Flags.CrosshairType or "Cross"
    local color = COLORS.BrightGreen

    local function createPart(size, pos, anchor, isCircular)
        local f = Instance.new("Frame")
        f.Size = size
        f.Position = pos
        f.AnchorPoint = anchor or Vector2.new(0.5, 0.5)
        f.BackgroundColor3 = color
        f.BorderSizePixel = 0
        if isCircular then
            Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
        end
        f.Parent = crosshairFrame
        table_insert(crosshairParts, f)
        return f
    end

    if cType == "Dot" then
        createPart(UDim2.new(0, 6, 0, 6), UDim2.new(0.5, 0, 0.5, 0), Vector2.new(0.5, 0.5), true)
    elseif cType == "Cross" then
        createPart(UDim2.new(0, 10, 0, 2), UDim2.new(0.5, 0, 0.5, 0))
        createPart(UDim2.new(0, 2, 0, 10), UDim2.new(0.5, 0, 0.5, 0))
    elseif cType == "Ring" then
        local ring = Instance.new("Frame")
        ring.Size = UDim2.new(0, 10, 0, 10)
        ring.Position = UDim2.new(0.5, 0, 0.5, 0)
        ring.AnchorPoint = Vector2.new(0.5, 0.5)
        ring.BackgroundTransparency = 1
        ring.Parent = crosshairFrame

        Instance.new("UICorner", ring).CornerRadius = UDim.new(1, 0)

        local stroke = Instance.new("UIStroke", ring)
        stroke.Thickness = 2
        stroke.Color = color
        stroke.Parent = ring

        table_insert(crosshairParts, ring)
    elseif cType == "Hook" then
        local crosshairSize = 16
        local verticalOffset = 0
        local hookLength = 8

        crosshairFrame.Size = UDim2.new(0, crosshairSize, 0, crosshairSize)
        crosshairFrame.Position = UDim2.new(0.5, 0, 0.5, verticalOffset)

        local function createLine(name, size, position)
            local line = Instance.new("Frame")
            line.Name = name
            line.Size = size
            line.Position = position
            line.AnchorPoint = Vector2.new(0.5, 0.5)
            line.BorderSizePixel = 0
            line.BackgroundColor3 = color
            line.Parent = crosshairFrame
            table_insert(crosshairParts, line)
            return line
        end

        createLine("Center_H", UDim2.new(1, 0, 0, 1), UDim2.new(0.5, 0, 0.5, 0))
        createLine("Center_V", UDim2.new(0, 1, 1, 0), UDim2.new(0.5, 0, 0.5, 0))
        createLine("Top_Hook", UDim2.new(0, hookLength, 0, 1), UDim2.new(0.5, hookLength / 2, 0, 0))
        createLine("Right_Hook", UDim2.new(0, 1, 0, hookLength), UDim2.new(1, 0, 0.5, hookLength / 2))
        createLine("Bottom_Hook", UDim2.new(0, hookLength, 0, 1), UDim2.new(0.5, -hookLength / 2, 1, 0))
        createLine("Left_Hook", UDim2.new(0, 1, 0, hookLength), UDim2.new(0, 0, 0.5, -hookLength / 2))
    end
end

