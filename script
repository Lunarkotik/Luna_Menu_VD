------------------------------------------------
-- TERROR RADIUS — FOV cone lines on floor
-- Two lines per killer: left and right edge of their view cone
-- Line length = ParryDistance so it matches AutoParry range exactly
-- Angle shared with AutoParry via Flags.TerrorAngle
------------------------------------------------
local terrorFolder = Instance.new("Folder")
terrorFolder.Name  = "LunaTerror"
terrorFolder.Parent = Workspace

local terrorCache  = {}  -- player -> {left=Part, right=Part}

local TERROR_Y_OFFSET = -2.8  -- floor level offset, same as ring

local function ensureTerrorLines(player)
    if terrorCache[player] then return terrorCache[player] end
    local function mkLine()
        local p=Instance.new("Part")
        p.Size=V3(0.08,0.08,1) p.Material=Enum.Material.Neon
        p.Color=Color3.fromRGB(255,60,60)
        p.Transparency=0.15 p.Anchored=true
        p.CanCollide=false p.CastShadow=false p.Parent=terrorFolder
        return p
    end
    local lines={left=mkLine(),right=mkLine()}
    terrorCache[player]=lines
    return lines
end

local function hideTerrorLines(player)
    local t=terrorCache[player] if not t then return end
    t.left.Transparency=1 t.right.Transparency=1
end

local function destroyTerrorCache()
    for _,t in pairs(terrorCache) do
        t.left:Destroy() t.right:Destroy()
    end
    terrorCache={}
end

-- Rotate a Vector3 (XZ plane) by angle radians around Y axis
local function rotateY(v, angle)
    local c=math_cos(angle) local s=math_sin(angle)
    return V3(c*v.X-s*v.Z, v.Y, s*v.X+c*v.Z)
end

local function stepTerror()
    if not Flags.TerrorRadius then
        if terrorFolder.Parent then
            terrorFolder.Parent=nil
            destroyTerrorCache()
        end
        return
    end
    if not terrorFolder.Parent then terrorFolder.Parent=Workspace end

    local len = Flags.ParryDistance
    local halfRad = math_rad(Flags.TerrorAngle / 2)
    local visited = {}

    for _,player in ipairs(Players:GetPlayers()) do
        if player~=LocalPlayer and isPlayerKiller(player) then
            local char=player.Character
            local hrp=char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                visited[player]=true
                local lines=ensureTerrorLines(player)
                local look=hrp.CFrame.LookVector
                -- Flatten look to XZ plane for ground projection
                local flatLook=V3(look.X,0,look.Z)
                if flatLook.Magnitude<0.001 then flatLook=V3(0,0,1) end
                flatLook=flatLook.Unit

                local origin=hrp.Position+V3(0,TERROR_Y_OFFSET,0)
                local leftDir=rotateY(flatLook,-halfRad)
                local rightDir=rotateY(flatLook, halfRad)

                -- CFrame: position = midpoint along the line, facing = direction
                local lMid=origin+leftDir*(len*0.5)
                local rMid=origin+rightDir*(len*0.5)

                -- Size the parts to match current line length
                lines.left.Size=V3(0.08,0.08,len)
                lines.right.Size=V3(0.08,0.08,len)

                lines.left.CFrame=CF(lMid,origin+leftDir*len)
                lines.right.CFrame=CF(rMid,origin+rightDir*len)

                -- Color: red if in parry range of us, orange otherwise
                local inRange = false
                if myRoot then
                    local d=myRoot.Position-hrp.Position
                    if d:Dot(d)<=len*len then inRange=true end
                end
                local col=inRange and Color3.fromRGB(255,30,30) or Color3.fromRGB(255,140,0)
                lines.left.Color=col lines.right.Color=col
                lines.left.Transparency=0.15 lines.right.Transparency=0.15
            else
                hideTerrorLines(player)
            end
        end
    end

    -- Hide lines for players no longer in killer team or disconnected
    for player,_ in pairs(terrorCache) do
        if not visited[player] then hideTerrorLines(player) end
    end
end

-- Cleanup terror lines when a killer leaves
Players.PlayerRemoving:Connect(function(player)
    local t=terrorCache[player]
    if t then t.left:Destroy() t.right:Destroy() terrorCache[player]=nil end
end)

