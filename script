local function LineInGoal(line,goal)
    local lr=line.Rotation%360 local gr=goal.Rotation%360
    local gs=(gr+103)%360 local ge=(gr+160)%360
    return gs>ge and (lr>=gs or lr<=ge) or (lr>=gs and lr<=ge)
end
task.spawn(function()
    while true do task.wait(0.015)
        if Flags.AutoSkill and LocalPlayer.Team and LocalPlayer.Team.Name=="Survivors" then
            local pg=LocalPlayer:FindFirstChild("PlayerGui")
            local cg=pg and pg:FindFirstChild("SkillCheckPromptGui")
            local check=cg and cg:FindFirstChild("Check")
            if check and check.Visible then
                local line=check:FindFirstChild("Line") local goal=check:FindFirstChild("Goal")
                if line and goal and LineInGoal(line,goal) then
                    VIM:SendKeyEvent(true,Enum.KeyCode.Space,false,game)
                    task.wait(0.01)
                    VIM:SendKeyEvent(false,Enum.KeyCode.Space,false,game)
                end
            end
        end
    end
end)

