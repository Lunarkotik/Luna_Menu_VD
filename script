local POOL_SIZE    = 15
local sparklePool  = {}
local sparkleAccum = 0
local sparklesFolder = nil

local function initSparkles()
    sparklesFolder=Instance.new("Folder")
    sparklesFolder.Name="LunaSparkles" sparklesFolder.Parent=Workspace
    for i=1,POOL_SIZE do
        local s=Instance.new("Part")
        s.Size=V3(0.15,0.15,0.15) s.Shape=Enum.PartType.Ball
        s.Material=Enum.Material.Neon s.Transparency=1
        s.Anchored=true s.CanCollide=false s.CastShadow=false s.Parent=sparklesFolder
        sparklePool[i]={part=s,inUse=false,endTime=0,startT=0,dur=0}
    end
end

local function acquireSparkle()
    local oldest,oldestEnd=nil,math.huge
    for _,sl in ipairs(sparklePool) do
        if not sl.inUse then return sl end
        if sl.endTime<oldestEnd then oldest=sl oldestEnd=sl.endTime end
    end
    if oldest then oldest.inUse=false end return oldest
end

local function stepSparkles(hrp, isDanger)
    local now=os_clock()
    for _,sl in ipairs(sparklePool) do
        if sl.inUse and now>=sl.endTime then sl.inUse=false sl.part.Transparency=1 end
    end
    sparkleAccum=sparkleAccum+0.3
    while sparkleAccum>=1 do
        sparkleAccum=sparkleAccum-1
        local sl=acquireSparkle()
        if sl then
            local angle=math_random()*math_pi*2
            local dist=math_random()*Flags.ParryDistance
            local col=isDanger and Color3.fromRGB(255,50,50) or Color3.fromRGB(0,210,255)
            sl.inUse=true sl.startT=now sl.endTime=now+5.0 sl.dur=5.0
            sl.part.Color=col sl.part.Transparency=0.3
            sl.part.Position=hrp.Position+V3(math_cos(angle)*dist,-2.8,math_sin(angle)*dist)
        end
    end
    for _,sl in ipairs(sparklePool) do
        if sl.inUse then
            local alpha=(now-sl.startT)/sl.dur
            sl.part.Position=sl.part.Position+V3(0,0.008,0)
            sl.part.Transparency=0.3+alpha*0.7
        end
    end
end

local function hideAllSparkles()
    for _,sl in ipairs(sparklePool) do
        if sl.inUse then sl.inUse=false sl.part.Transparency=1 end
    end
end

initSparkles()

